{
  "manifest_version": 3,
  "name": "Discord / Telegram 外语翻译器",
  "short_name": "DXT",
  "version": "1.4.7",
  "description": "自动翻译 Discord 与 Telegram 网页版里的外语消息，支持 Google、腾讯、Bing、DeepL、有道、大模型等多种翻译源。",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.discord.com/*",
    "https://web.telegram.org/*",
    "https://translate.googleapis.com/*",
    "https://transmart.qq.com/*",
    "https://edge.microsoft.com/*",
    "https://api-edge.cognitive.microsofttranslator.com/*",
    "https://api.mymemory.translated.net/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://openapi.youdao.com/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://*.discord.com/*", "https://web.telegram.org/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Discord / Telegram 翻译器"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
